# Copy this file to server/.env and fill in your keys, then restart the backend.
# These are server-side secrets — they are NEVER exposed to the browser.

# --- Plaid (Phase 2) ---
# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox = free test banks (use to build/test) | production = real banks
PLAID_ENV=sandbox
# Optional: only needed if you expose a public HTTPS webhook for background sync
# PLAID_WEBHOOK=

# --- Encryption (optional) ---
# 64 hex chars (32 bytes) used to encrypt stored Plaid access tokens.
# If unset, a key is auto-generated at server/data/secret.key.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FG_ENCRYPTION_KEY=

# --- Anthropic (Phase 3, not used yet) ---
# ANTHROPIC_API_KEY=
