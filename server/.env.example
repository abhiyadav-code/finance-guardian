# Copy this file to server/.env and fill in your keys, then restart the backend.
# These are server-side secrets — they are NEVER exposed to the browser.

# --- Plaid (Phase 2) ---
# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox = free test banks (use to build/test) | production = real banks
PLAID_ENV=sandbox
# Optional: only needed if you expose a public HTTPS webhook for background sync
# PLAID_WEBHOOK=

# --- Encryption (optional) ---
# 64 hex chars (32 bytes) used to encrypt stored Plaid access tokens.
# If unset, a key is auto-generated at server/data/secret.key.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FG_ENCRYPTION_KEY=

# --- AI budget suggestions (optional) ---
# Set an Anthropic API key to power "AI budget assistant" on the Cash flow →
# Budget tab with Claude. Without it, a local heuristic is used instead.
# ANTHROPIC_API_KEY=
# Model for suggestions (defaults to claude-opus-5). Use a cheaper tier if you like:
# FG_AI_MODEL=claude-haiku-4-5

# --- Agent brief endpoint (optional) ---
# Require a token on GET /api/agent/brief (see AGENT.md). Leave unset to keep it
# open on localhost.
# FG_AGENT_TOKEN=
